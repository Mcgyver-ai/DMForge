// Firestore Security Rules for DMForge
// All writes go through our server (admin SDK bypasses these rules).
// Share pages (/r/[id]) read results server-side via the admin SDK, so
// clients get no direct access: a public read rule would let anyone list
// every lead transcript with the (public) Firebase web config.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /results/{id} {
      allow read, write: if false;
    }
    match /agents/{id} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }
    match /users/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
